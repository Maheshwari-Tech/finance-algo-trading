# /opt/algo-trading/.env on the server. Never commit. CircleCI writes APP_IMAGE on each deploy.
DOMAIN=backtest.example.com
ACME_EMAIL=you@example.com
APP_IMAGE=ghcr.io/OWNER/algo-trading:latest

APP_ENV=production
DATABASE_URL=postgres://user:pass@host:port/db?sslmode=require
REDIS_URL=rediss://default:pass@host:port
SECRET_KEY=
ADMIN_MOBILES=
ALLOWED_MOBILES=
DEFAULT_COUNTRY_CODE=91
AUTH_MODE=dev
OTP_DEV_CODE=
AUTO_CREATE_SCHEMA=true
LOG_LEVEL=INFO

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
