# Infrastructure and secrets only. Tunable behaviour lives in /config/*.json.
# Copy to .env (git-ignored). Never commit real values.

# development | production. Production enforces a long SECRET_KEY, a non-guessable OTP_DEV_CODE, JSON logs and hides /docs.
APP_ENV=development

# Any SQLAlchemy URL. Postgres (Aiven/Supabase): postgres://user:pass@host:port/db?sslmode=require   Local: sqlite:///var/local.db
DATABASE_URL=sqlite:///var/local.db

# Long random string used to hash OTPs. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Comma separated mobile numbers that get the admin role (local or +country format)
ADMIN_MOBILES=

# Prepended to 10-digit numbers, e.g. 91
DEFAULT_COUNTRY_CODE=91

# dev = one fixed access code (OTP_DEV_CODE), nothing is sent. prod = needs an SMS provider (see backend/app/auth/otp.py)
AUTH_MODE=dev
# Must be otp_length digits (config/auth.json). In production pick a random one: python3 -c "import secrets;print(f'{secrets.randbelow(10**6):06d}')"
OTP_DEV_CODE=

# Optional: only these numbers (plus admins) can sign in. Recommended while using a fixed code.
# ALLOWED_MOBILES=

# Optional: Redis/Valkey for shared rate-limit counters, e.g. rediss://default:pass@host:port
# REDIS_URL=

# Optional
# LOG_LEVEL=INFO
# LOG_JSON=true
# CORS_ORIGINS=http://localhost:5173
# AUTO_CREATE_SCHEMA=true     create tables on startup. Or run backend/schema.sql once
# CONFIG_DIR=  EXAMPLES_DIR=  FRONTEND_DIST=
