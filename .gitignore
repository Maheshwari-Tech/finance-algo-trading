# Secrets — never commit
.env
.env.*
!.env.example
deploy/.env
deploy/.env.*
!deploy/.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
test-results/
verify.log
var/
*.db

# Node / frontend
frontend/node_modules/
frontend/dist/

# Editors / OS
.idea/
.vscode/
.DS_Store

# Terraform (the lock file IS committed)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
backend.hcl
crash.log
